{
  "name": "suu",
  "private": true,
  "version": "0.4.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "web": "sh tools/build-web.sh && bun tools/serve.ts",
    "build:web": "sh tools/build-web.sh",
    "build:plugin": "cd plugin && cargo xtask bundle -p suu_fx -p suu_synth --release",
    "test": "cargo test --workspace && cd plugin && cargo test --workspace",
    "typecheck": "tsc --noEmit",
    "e2e": "bun tools/e2e-web.ts && bun tools/e2e-plugin.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
